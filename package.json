{
  "name": "eve-flight-journal",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "for f in *.js ui/*.js ui/screens/*.js scripts/*.mjs worker/index.js; do node --check \"$f\" || exit 1; done",
    "test": "node --test tests/*.test.js",
    "start": "node scripts/static-server.mjs",
    "test:e2e": "playwright test --grep-invert LIVE:",
    "test:live": "playwright test --grep LIVE:"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "wrangler": "^4.156.0"
  }
}
