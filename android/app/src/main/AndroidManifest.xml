<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Fly timers: an ongoing countdown and an alert at zero while the app is in the background. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- Fly timers: exact alarms for the warning before the end and for the end (a rationale screen sends the person to the
         switch; without it the alerts still come, only possibly late). RECEIVE_BOOT_COMPLETED sets them again after a reboot. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:name=".EchelonApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.Echelon.Splash">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- EVE SSO comes back here through the Worker: echelon://auth/callback?code=…&pilot=… -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="${authScheme}" android:host="auth" android:path="/callback" />
            </intent-filter>
            <!-- Long-press shortcuts: Gas timer, Mining cycle, Cockpit (res/xml/shortcuts.xml). -->
            <meta-data android:name="android.app.shortcuts" android:resource="@xml/shortcuts" />
        </activity>
        <!-- The Gas timer and Mining cycle shortcuts: act and finish with a toast, no screen. -->
        <activity
            android:name=".fly.cockpit.ShortcutActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />
        <!-- Fly timers (fly.timers.TimerService): Android has no timer service type, so it is a declared special use. -->
        <service
            android:name=".fly.timers.TimerService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="User-started countdown timers for a game session, shown in an ongoing notification with an alert when each ends." />
        </service>
        <!-- Fly timers' exact alarms: posts the warning or the end even if the service and the app were killed. -->
        <receiver android:name=".fly.timers.TimerAlarmReceiver" android:exported="false" />
        <!-- Sets the alarms again after a reboot, an update, a clock change or a change of the exact-alarm switch. -->
        <receiver android:name=".fly.timers.TimerBootReceiver" android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>
        <!-- The cockpit on its own (fly.cockpit.CockpitActivity): opened by the home-screen widget, and by a long press on
             the Quick Settings tile (QS_TILE_PREFERENCES). Not exported beyond that intent. -->
        <activity
            android:name=".fly.cockpit.CockpitActivity"
            android:exported="true"
            android:label="@string/cockpit_activity_label"
            android:theme="@style/Theme.Echelon"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE_PREFERENCES" />
            </intent-filter>
        </activity>
        <!-- Cockpit home-screen widget: next timer, last place, next mining cycle in one tap. -->
        <receiver
            android:name=".fly.cockpit.CockpitWidget"
            android:exported="false"
            android:label="@string/cockpit_widget_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/cockpit_widget_info" />
        </receiver>
        <!-- Quick Settings tile "Mining cycle": restart (or start) the flying pilot's mining timer from the shade. -->
        <service
            android:name=".fly.cockpit.CockpitTile"
            android:exported="true"
            android:icon="@drawable/cockpit_tile_icon"
            android:label="@string/cockpit_tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data
                android:name="android.service.quicksettings.ACTIVE_TILE"
                android:value="false" />
        </service>
        <!-- Quick Settings tile "Gas timer": start the Sleeper (or known-space gas) timer, or show it counting and stop it. -->
        <service
            android:name=".fly.cockpit.GasTile"
            android:exported="true"
            android:icon="@drawable/gas_tile_icon"
            android:label="@string/gas_tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data
                android:name="android.service.quicksettings.ACTIVE_TILE"
                android:value="false" />
        </service>
        <!-- Wing pushes (optional Firebase): a wingmate's timer or ping while the app is closed. -->
        <service
            android:name=".core.push.EchelonMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
    </application>
    <queries>
        <intent>
            <action android:name="android.support.customtabs.action.CustomTabsService" />
        </intent>
    </queries>
</manifest>
