<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Mirrors styles/tokens.css for the window and the splash, before Compose draws. -->
    <color name="bg">#0C1424</color>
    <color name="accent">#A99BFF</color>

    <style name="Theme.Echelon" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
    </style>
    <style name="Theme.Echelon.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/bg</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_emblem</item>
        <item name="postSplashScreenTheme">@style/Theme.Echelon</item>
    </style>
</resources>
