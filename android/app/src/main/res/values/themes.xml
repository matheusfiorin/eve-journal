<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Echelon" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:colorAccent">@color/accent</item>
    </style>
    <!-- The splash: the formation assembles on ink (avd_splash), then MainActivity hands over with a lift and a fade. -->
    <style name="Theme.Echelon.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/bg</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/avd_splash</item>
        <item name="windowSplashScreenAnimationDuration">900</item>
        <item name="postSplashScreenTheme">@style/Theme.Echelon</item>
    </style>
</resources>
